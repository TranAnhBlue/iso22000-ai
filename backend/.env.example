PROJECT_NAME="ISO22000 AI Platform"
ENVIRONMENT=production
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Comma-separated, exact browser origins allowed to call the API.
CORS_ORIGINS=https://your-frontend.onrender.com
# Keep sample/demo data creation disabled in deployed environments.
ENABLE_DEMO_SEED=false
# Private document and calibration-certificate storage. Never expose the
# service-role key to the frontend or commit the real value.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=fsms-documents
